rules_version = '2';
// Last Updated: 2026-09-13
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Config & Timer
    match /config/{id} {
      allow read, write: if true;
    }

    // Registrations & Users
    match /pendingRegistrations/{id} {
      allow read, write: if true;
    }

    match /registeredUsers/{id} {
      allow read, write: if true;
    }

    // Members & Results
    match /members/{id} {
      allow read, write: if true;
    }

    match /results/{id} {
      allow read, write: if true;
    }

    // Rankings
    match /leaderRanking/{id} {
      allow read, write: if true;
    }

    match /trainerRanking/{id} {
      allow read, write: if true;
    }

    // Logs & Balances
    match /userBalances/{id} {
      allow read, write: if true;
    }

    match /submissionLogs/{id} {
      allow read, write: if true;
    }

    match /auditLogs/{id} {
      allow read, write: if true;
    }

    // Quick Links & Notifications
    match /quickLinks/{id} {
      allow read, write: if true;
    }

    match /notifications/{id} {
      allow read, write: if true;
    }

    // Applications & Attendance
    match /applications/{id} {
      allow read, write: if true;
    }

    match /teachers/{id} {
      allow read, write: if true;
    }

    match /teacherAttendance/{id} {
      allow read, write: if true;
    }

    match /stlMembers/{id} {
      allow read, write: if true;
    }

    match /stlAttendance/{id} {
      allow read, write: if true;
    }

    match /demoMembers/{id} {
      allow read, write: if true;
    }

    match /demoAttendance/{id} {
      allow read, write: if true;
    }

    match /systemConfig/{id} {
      allow read, write: if true;
    }

    // Catch-all for any additional collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
